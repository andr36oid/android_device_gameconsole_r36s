odroidgoa-uboot-config

# Android boot: kernel, first-stage ramdisk (with Magisk) and DTB. The ramdisk's init
# mounts system and vendor by partition name and switches root into system, so no
# root= here. The first boot runs boot.ini (the resizer), which then puts this file
# in its place.

setenv bootrootfs "fw_devlink=permissive rootwait consoleblank=0 swiotlb=1 coherent_pool=1m"

setenv console "console=ttyS2,115200n8 androidboot.console=ttyS2 vt.global_cursor_default=0"

setenv android "firmware_class.path=/vendor/firmware androidboot.hardware=rk30board androidboot.selinux=permissive androidboot.verifiedbootstate=green"

setenv android2 "androidboot.revision=${hwrev} androidboot.serialno=${serial#} androidboot.boot_devices=ff370000.dwmmc"

# Set load addresses
setenv kernel_addr_r "0x02000000"
setenv fdt_addr_r "0x01f00000"
setenv ramdisk_addr_r "0x0a200000"
# Use the ramdisk and DTB where they are loaded
setenv initrd_high "0xffffffffffffffff"
setenv fdt_high "0xffffffffffffffff"

load mmc 1:1 ${fdt_addr_r} rk3326-r36s-android.dtb

# If FN pressed
if gpio input c4
then
    # The recovery kernel carries its own ramdisk
    load mmc 1:1 ${kernel_addr_r} Image-recovery
    setenv bootargs "root=/dev/mmcblk0p2 rootfstype=ext4 init=/init ${bootrootfs} ${android} ${android2} ${console}"
    booti ${kernel_addr_r} - ${fdt_addr_r}
else
    load mmc 1:1 ${kernel_addr_r} Image
    # A legacy uImage: this U-Boot has no raw initrd support (addr:size)
    load mmc 1:1 ${ramdisk_addr_r} ramdisk.uimg
    setenv bootargs "${bootrootfs} ${android} ${android2} ${console}"
    booti ${kernel_addr_r} ${ramdisk_addr_r} ${fdt_addr_r}
fi
